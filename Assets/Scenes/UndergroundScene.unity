  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 47dab1d145cd8044bb1e21746125e3e2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteraction
  dialoguePanel: {fileID: 2010143905}
  dialogueText: {fileID: 304745436}
  nameText: {fileID: 336134804}
  fadeAnimator: {fileID: 77366583}
  menuSceneName: MenuScene
  endingImageDisplay: {fileID: 877917628}
  endingSprites:
  - {fileID: 21300000, guid: 82de6d38205f7c9499f3cb10b8945bcd, type: 3}
  - {fileID: 21300000, guid: e25a973504b821d408ee204a7d77b38d, type: 3}
  - {fileID: 21300000, guid: 56d6cfe7c37837e47b4d6741c8b9a73f, type: 3}
  conversation:
  - name: Terence
    text: "\u2026Susan ? C-c\u2019est bien toi\u2026 ? Qu\u2019est ce que tu fais
      l\xE0 ? Tu es cens\xE9e \xEAtre\u2026"
  - name: Susan
    text: "Oui\u2026 J\u2019attendais papa, il devait venir me chercher."
  - name: Terence
    text: "Michael\u2026? Il ne viendra pas Suzanne. Mais\u2026 tu n\u2019as plus
      besoin d\u2019attendre. Ce qui te retenait ici\u2026 c\u2019est fini maintenant."
  - name: Susan
    text: "Ah\u2026\xE7a veut dire que e peux enfin partir ?"
  - name: Terence
    text: "Oui, tu peux sortir d\u2019ici. Tu es libre maintenant. Tu peux enfin
      te reposer, ma petite."
  - name: Susan
    text: "J\u2019avais peur toute seule. Mais\u2026 \xE7a va mieux maintenant. Merci\u2026
      monsieur."
  - name: Terence
    text: "\u2026Repose en paix, Susan."
